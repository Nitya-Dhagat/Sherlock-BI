{
  "version": "1.0",
  "tools": {
    "detect_anomaly": {
      "request": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "net_revenue",
              "gross_revenue",
              "orders",
              "active_customers",
              "aov"
            ]
          },
          "period": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": true
          },
          "compare_to": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "previous_period",
                  "same_period_last_year"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": true
              }
            ]
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dimension": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "dimension",
                "value"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "metric",
          "period",
          "compare_to"
        ],
        "additionalProperties": true
      },
      "response": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^E\\d+$"
          },
          "definition": {
            "type": "string"
          },
          "data_through": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "metric": {
            "type": "string",
            "enum": [
              "net_revenue",
              "gross_revenue",
              "orders",
              "active_customers",
              "aov"
            ]
          },
          "actual": {
            "type": "number"
          },
          "expected": {
            "type": "number"
          },
          "change_pct": {
            "type": "number"
          },
          "z_score": {
            "type": "number"
          },
          "severity": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "yoy",
              "stl"
            ]
          },
          "baseline": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": true
          },
          "trading_days": {
            "type": "object",
            "properties": {
              "actual": {
                "type": "integer"
              },
              "expected": {
                "type": "integer"
              }
            },
            "required": [
              "actual",
              "expected"
            ],
            "additionalProperties": true
          },
          "trading_day_adjusted": {
            "type": "boolean"
          },
          "partial_period_excluded": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
                    "yoy",
                    "stl"
                  ]
                },
                "change_pct": {
                  "type": "number"
                },
                "z_score": {
                  "type": "number"
                }
              },
              "required": [
                "method",
                "change_pct",
                "z_score"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "evidence_id",
          "definition",
          "data_through",
          "metric",
          "actual",
          "expected",
          "change_pct",
          "z_score",
          "severity",
          "method",
          "baseline",
          "trading_days",
          "trading_day_adjusted",
          "partial_period_excluded",
          "checks"
        ],
        "additionalProperties": true
      }
    },
